JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30
API_USERNAME=admin
API_PASSWORD=changeme
# Local Docker: mount ./models at /app/model (see docker-compose.yml) and use e.g.:
# MODEL_PATH=model/extended_20ep/weights/best.pt
MODEL_PATH=model/best.pt
MAX_FILE_SIZE_MB=10
MAX_BATCH_IMAGES=16
RATE_LIMIT=30/minute
CORS_ORIGINS=["http://localhost:3000"]
