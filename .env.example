JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30
API_USERNAME=admin
API_PASSWORD=changeme
# Local dev: default points at repo models/extended_20ep/weights/best.pt (sibling of api/).
# Docker: compose mounts ./models at /app/model — set MODEL_PATH=model/extended_20ep/weights/best.pt
MODEL_PATH=models/extended_20ep/weights/best.pt
MAX_FILE_SIZE_MB=10
MAX_BATCH_IMAGES=16
RATE_LIMIT=30/minute
CORS_ORIGINS=["http://localhost:3000"]
